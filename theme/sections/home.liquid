{%- comment -%} Hero slides come from your main menu: one slide per collection link, showing its first product. {%- endcomment -%}
<section class="hero" id="hero" aria-label="{{ 'home.featured' | t }}" data-hero>
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="slides" id="slides">
    {%- assign n = 0 -%}
    {%- for link in linklists['main-menu'].links -%}
      {%- if link.type == 'collection_link' and link.object != blank and link.object.products.size > 0 and n < 6 -%}
        {%- assign product = link.object.products.first -%}
        <article class="slide{% if n == 0 %} is-active{% endif %}" data-hue="{{ n | times: 61 | plus: 340 | modulo: 360 }}" data-slide="{{ n }}"{% if n != 0 %} aria-hidden="true"{% endif %}>
          <div class="hero-copy">
            <p class="eyebrow">{{ link.title }}</p>
            <h1 class="hero-h">{{ product.title }}</h1>
            <p class="hero-sub">{{ 'home.discover' | t: room: link.title }}</p>
            <div class="hero-actions"><a class="btn primary" href="{{ product.url }}"{% if n != 0 %} tabindex="-1"{% endif %}>{{ 'home.open' | t }}</a></div>
          </div>
          <div class="hero-art">
            <figure class="ph">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400, 600, 900', sizes: '(min-width: 760px) 28vw, 70vw', alt: '' }}{% endif %}</figure>
            <p class="hero-price">{% render 'price', product: product %}</p>
          </div>
        </article>
        {%- assign n = n | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if n > 1 -%}
    <div class="hero-nav-row">
      <div class="hero-nav">
        <button type="button" class="ctl" data-hero-prev aria-label="{{ 'home.prev' | t }}">‹</button>
        <div class="hero-dots" data-hero-dots role="group" aria-label="{{ 'home.featured' | t }}">
          {%- for i in (1..n) -%}<button type="button" data-go="{{ forloop.index0 }}" aria-label="{{ 'home.show' | t }} {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"></button>{%- endfor -%}
        </div>
        <button type="button" class="ctl" data-hero-next aria-label="{{ 'home.next' | t }}">›</button>
        <button type="button" class="ctl" data-hero-pause aria-pressed="false" aria-label="{{ 'home.pause' | t }}">❚❚</button>
      </div>
    </div>
    <div class="hero-bar" aria-hidden="true"><i data-hero-prog></i></div>
  {%- endif -%}
</section>

<header class="feed-head">
  <h2>{{ section.settings.feed_title }}</h2>
  <p>{{ collections.all.products_count }} {{ 'home.pieces' | t }}</p>
</header>

{%- paginate collections.all.products by section.settings.per_page -%}
  <div class="feed" id="feed">
    {%- for product in collections.all.products -%}
      {% render 'product-card', product: product, index: forloop.index0 %}
    {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}
    <nav class="pager" aria-label="{{ 'general.pagination' | t }}">
      {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">‹</a>{%- endif -%}
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- elsif part.title == paginate.current_page -%}<span class="cur" aria-current="page">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}
      {%- endfor -%}
      {%- if paginate.next -%}<a href="{{ paginate.next.url }}">›</a>{%- endif -%}
    </nav>
  {%- endif -%}
{%- endpaginate -%}

{% schema %}
{
  "name": "Discover home",
  "settings": [
    { "type": "text", "id": "feed_title", "label": "Feed title", "default": "All rooms" },
    { "type": "range", "id": "per_page", "min": 8, "max": 48, "step": 4, "default": 24, "label": "Products per page" }
  ],
  "presets": [{ "name": "Discover home" }]
}
{% endschema %}
