<header class="page-head"><div><h1>{{ 'general.search' | t }}</h1>{% if search.performed %}<p>{{ search.results_count }} {{ 'search.results' | t }} “{{ search.terms | escape }}”</p>{% endif %}</div></header>
{%- if search.performed -%}
  {%- paginate search.results by 24 -%}
    {%- if search.results_count == 0 -%}
      <p class="empty-state">{{ 'search.none' | t }}</p>
    {%- else -%}
      <div class="feed">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{% render 'product-card', product: item, index: forloop.index0 %}{%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if paginate.pages > 1 -%}
      <nav class="pager" aria-label="{{ 'general.pagination' | t }}">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">‹</a>{%- endif -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">›</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
{%- else -%}
  <p class="empty-state">{{ 'search.prompt' | t }}</p>
{%- endif -%}
{% schema %}
{ "name": "Search" }
{% endschema %}
