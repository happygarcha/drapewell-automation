{%- comment -%} Usage: render 'hero-slide', product: product, label: 'New', sub: 'text', n: 0 {%- endcomment -%}
<article class="slide{% if n == 0 %} is-active{% endif %}" data-hue="{{ n | times: 61 | plus: 340 | modulo: 360 }}" data-slide="{{ n }}"{% if n != 0 %} aria-hidden="true"{% endif %}>
  <div class="hero-copy stagger">
    <p class="eyebrow">{{ label }}</p>
    {%- if n == 0 -%}<h1 class="hero-h">{{ product.title }}</h1>{%- else -%}<h2 class="hero-h">{{ product.title }}</h2>{%- endif -%}
    <p class="hero-sub">{{ sub }}</p>
    <div class="hero-actions"><a class="btn primary" href="{{ product.url }}"{% if n != 0 %} tabindex="-1"{% endif %}>{{ 'home.open' | t }}</a></div>
  </div>
  <div class="hero-art">
    <figure class="ph">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400, 600, 900', sizes: '(min-width: 760px) 28vw, 70vw', alt: '' }}{% endif %}</figure>
    <p class="hero-price">{% render 'price', product: product %}</p>
  </div>
</article>
