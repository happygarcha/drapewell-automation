{%- comment -%} Usage: render 'price', product: product {%- endcomment -%}
{%- if product.available == false -%}
  <span class="soldout">{{ 'general.sold_out' | t }}</span>
{%- else -%}
  {%- if product.price_varies -%}{{ 'general.from' | t }} {% endif -%}
  {{ product.price | money }}
  {%- if product.compare_at_price > product.price and product.price_varies == false -%}<s class="was">{{ product.compare_at_price | money }}</s>{%- endif -%}
{%- endif -%}
