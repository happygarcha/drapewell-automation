{%- comment -%} Usage: render 'product-card', product: product, index: forloop.index0 {%- endcomment -%}
<div class="cell">
  <a class="card" href="{{ product.url }}" style="--i: {{ index | default: 0 | at_most: 14 }}">
    {%- comment -%} Room chip: the product's own room (never Home page, Seasonal or Gifts), and not on collection pages where every card is the same room. {%- endcomment -%}
    {%- assign room_chip = '' -%}
    {%- unless request.page_type == 'collection' -%}
      {%- for c in product.collections -%}
        {%- if room_chip == '' and c.handle != 'frontpage' and c.handle != 'seasonal' and c.handle != 'gifts-under-25' and c.handle != 'halloween' and c.handle != 'all' -%}
          {%- assign room_chip = c.title -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endunless -%}
    {%- if room_chip != '' -%}<span class="chip">{{ room_chip }}</span>{%- endif -%}
    <figure class="ph" style="view-transition-name: pv-{{ product.handle }}">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 500, 700', sizes: '(min-width: 1500px) 20vw, (min-width: 760px) 24vw, 46vw', alt: product.featured_image.alt | default: product.title }}
      {%- endif -%}
      {%- if product.images.size > 1 -%}
        {{ product.images[1] | image_url: width: 500 | image_tag: loading: 'lazy', class: 'alt', widths: '300, 500', sizes: '(min-width: 1500px) 20vw, (min-width: 760px) 24vw, 46vw', alt: '' }}
      {%- endif -%}
    </figure>
    <span class="t">{{ product.title }}</span>
    {% render 'rating-stars', product: product %}
    <span class="p">{% render 'price', product: product %}</span>
  </a>
  {%- if product.available -%}
    <button type="button" class="qv" data-quick="{{ product.handle }}" aria-label="{{ 'general.quick_view' | t }}: {{ product.title | escape }}"><span aria-hidden="true">+</span></button>
  {%- endif -%}
</div>
