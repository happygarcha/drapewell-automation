{%- comment -%}
  Trust row for the product page. Every line states something from the store's own Shipping and Refund policies
  (checked against the live policies when this was written). If a policy changes, change the wording in locales/en.default.json.
{%- endcomment -%}
<section class="trust" aria-label="{{ 'product.trust_label' | t }}">
  <ul class="trust-list">
    <li>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
      <div><strong>{{ 'product.trust_ship_h' | t }}</strong><span>{{ 'product.trust_ship_b' | t }}</span></div>
    </li>
    <li>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V6z"/><path d="M9 12l2.2 2.2L15.5 10"/></svg>
      <div><strong>{{ 'product.trust_fix_h' | t }}</strong><span>{{ 'product.trust_fix_b' | t }}</span></div>
    </li>
    <li>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
      <div><strong>{{ 'product.trust_pay_h' | t }}</strong><span>{{ 'product.trust_pay_b' | t }}</span></div>
    </li>
  </ul>
  <p class="trust-note">{{ 'product.trust_note' | t }}
    {%- if shop.shipping_policy.url != blank %} <a href="{{ shop.shipping_policy.url }}">{{ 'product.shipping_policy' | t }}</a>{% endif -%}
    {%- if shop.refund_policy.url != blank %} · <a href="{{ shop.refund_policy.url }}">{{ 'product.refund_policy' | t }}</a>{% endif -%}
  </p>
</section>
